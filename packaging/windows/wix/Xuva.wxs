<?xml version="1.0" encoding="utf-8"?>
<!--
  Xuva single-installer MSI (WiX v5) — step 3.

  Scope of THIS file (first slice): install the "Media server engine"
  (xuva-server.exe) into Program Files and register + start it as the
  "XuvaMediaServer" Windows Service. Subsequent slices add: ffmpeg/ffprobe,
  the ProgramData tree + ACLs, the optional service/tray FEATURE split, the WiX
  Firewall rules, and the SYSTEM updater.

  Build inputs are staged next to this file by build-msi.ps1 (xuva-server.exe),
  so File/@Source uses a bare filename resolved from the build working directory.

  SERVICE LAUNCH — the service runs the BARE xuva-server.exe with NO arguments.
  The binary detects the SCM context via svc.IsWindowsService() and runs the
  service handler itself. Passing "service run" (or any "service ..." arg) would
  instead hit the console verb handler in main() and exit — do NOT add Arguments.

  The ServiceInstall/ServiceControl live in the SAME component as the exe: a
  Windows service's image path is the component's KeyPath file, so they must be
  co-located with xuva-server.exe (this is also why service is not yet a separate
  optional feature — that split comes with a Condition-gated follow-up).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- ProductVersion is supplied by build-msi.ps1 as `-d Version=<x.y.z.0>`
       (normalized from the release tag). The fallback keeps a bare `wix build`
       working for local/dev compiles. MajorUpgrade compares ProductVersion, so
       this MUST increase release-over-release for self-update to fire. -->
  <?ifndef Version?>
    <?define Version="0.0.0.0"?>
  <?endif?>
  <Package
      Name="Xuva Media Server"
      Manufacturer="Xuva"
      Version="$(var.Version)"
      UpgradeCode="7C9E6A2B-1F4D-4E8A-9B3C-2A5D8F0E1C44"
      Scope="perMachine"
      Compressed="yes">

    <!-- Stable UpgradeCode + MajorUpgrade: a newer MSI removes the old and
         installs the new (the substrate for prompt-free in-app upgrades). -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Xuva Media Server is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Optional unattended override for where the service keeps ALL runtime
         state (data, logs, transcode, cache, ...). When unset, the service
         defaults to C:\ProgramData\Xuva. Set it for an isolated/relocated
         install, e.g.:
           msiexec /i xuva.msi /qn XUVA_RUNTIME_HOME="D:\XuvaData"
         Public (uppercase) + Secure so it survives the elevation handoff. -->
    <Property Id="XUVA_RUNTIME_HOME" Secure="yes" />

    <!-- Auto-update is on by default; set XUVA_AUTO_UPDATE=0 at install to opt
         out, e.g.  msiexec /i xuva.msi /qn XUVA_AUTO_UPDATE=0
         The value is written to HKLM\SOFTWARE\Xuva\AutoUpdate (below) and read
         by the service: when enabled it registers the SYSTEM scheduled task that
         runs the updater; when disabled it removes the task. An admin can flip
         the registry value post-install and restart the service. -->
    <Property Id="XUVA_AUTO_UPDATE" Value="1" Secure="yes" />

    <!-- C:\Program Files\Xuva\  with a bin\ for ffmpeg/ffprobe and a tray\
         for the Electron desktop bundle (TrayFeature). The server auto-detects
         <exeDir>\bin\ffmpeg.exe when XUVA_FFMPEG_PATH is unset (see
         config.resolveBundledTool), so the service finds these with no extra
         configuration. The Electron payload lives under tray\ so its many files
         (Xuva.exe + Electron framework + resources) don't co-mingle with the
         engine's xuva-server.exe + bin\ — easier to inspect, safer for major
         upgrades that swap Electron versions. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Xuva">
        <Directory Id="BinFolder" Name="bin" />
        <Directory Id="TrayInstallFolder" Name="tray" />
      </Directory>
    </StandardDirectory>

    <!-- All Users\Start Menu\Programs\Xuva\  — populated only when the
         TrayFeature is installed (the engine + service have no user-facing
         shortcut; they're services/CLI). The folder is removed by the shortcut
         component on uninstall. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="XuvaStartMenuFolder" Name="Xuva" />
    </StandardDirectory>

    <!--
      Feature scaffold for the convergence (see #451). Splitting the historical
      single "Main" Feature into selectable Features lets a future slice add an
      optional "Desktop tray app" payload without changing how the server today
      installs. ADDLOCAL=EngineFeature (or default ADDLOCAL=ALL) reproduces the
      pre-convergence install exactly; ADDLOCAL=EngineFeature,TrayFeature also
      installs the tray once it ships.

      EngineFeature is the always-on payload (server exe + ffmpeg + the service
      + the SYSTEM updater). AllowAbsent="no" prevents msiexec from skipping it
      via ADDLOCAL — a Xuva install without the engine isn't a thing.

      TrayFeature is intentionally empty in this slice: the tray Electron payload
      and Start Menu shortcut are added in the follow-up convergence PR. An empty
      Feature is valid in MSI — it installs nothing when selected — and lets us
      validate the scaffold compiles + the default ADDLOCAL behaviour is
      unchanged before adding ~150-200MB of files. AllowAdvertise="no" keeps
      both features local-only (no MSI advertise/install-on-first-use).
    -->
    <Feature Id="EngineFeature"
             Title="Media server engine"
             Description="The Xuva media server, ffmpeg/ffprobe, the Windows Service that runs the server at boot, and the SYSTEM auto-updater. Required."
             Level="1"
             AllowAbsent="no"
             AllowAdvertise="no"
             InstallDefault="local"
             TypicalDefault="install"
             Display="2">
      <ComponentGroupRef Id="EngineComponents" />
      <ComponentGroupRef Id="FfmpegComponents" />
      <ComponentRef Id="ServiceEnvironmentComponent" />
      <ComponentRef Id="UpdaterTaskComponent" />
    </Feature>

    <Feature Id="TrayFeature"
             Title="Desktop tray app"
             Description="System tray launcher for browsing the local Xuva server. Optional."
             Level="1"
             AllowAbsent="yes"
             AllowAdvertise="no"
             InstallDefault="local"
             TypicalDefault="install"
             Display="4">
      <!-- TrayComponents is generated at build time by `wix heat` from the
           electron-builder unpacked output (see build-msi.ps1). The fragment
           anchors everything under TrayInstallFolder via heat's `-dr` flag, so
           File/@Source paths resolve via the $(var.TraySource) preprocessor
           variable build-msi.ps1 passes with -d TraySource=<staging>\tray. -->
      <ComponentGroupRef Id="TrayComponents" />
      <ComponentRef Id="TrayShortcutComponent" />
    </Feature>

    <ComponentGroup Id="EngineComponents" Directory="INSTALLFOLDER">
      <Component Id="ServerExeComponent" Bitness="always64">
        <File Id="XuvaServerExe" Name="xuva-server.exe" Source="xuva-server.exe" KeyPath="yes" />

        <ServiceInstall
            Id="XuvaServiceInstall"
            Name="XuvaMediaServer"
            DisplayName="Xuva Media Server"
            Description="Xuva self-hosted media server (headless)."
            Type="ownProcess"
            Start="auto"
            ErrorControl="normal"
            Account="LocalSystem"
            Vital="yes" />
        <ServiceControl
            Id="XuvaServiceControl"
            Name="XuvaMediaServer"
            Start="install"
            Stop="both"
            Remove="uninstall"
            Wait="yes" />

        <!-- Firewall: handled by the server itself. On startup the service
             (LocalSystem) runs `netsh advfirewall firewall add rule` to open the
             inbound HTTP port (see internal/firewall/firewall_windows.go). The
             WiX Firewall extension was tried here but its v5 custom action fails
             with "All interfaces are empty values", and the netsh path — whose
             only drawback (UAC) was a DESKTOP concern, not a LocalSystem service
             one — is proven working on the box. So no WiX firewall rule. -->
      </Component>
    </ComponentGroup>

    <!-- ffmpeg/ffprobe (BtbN LGPL build), staged into bin\ by build-msi.ps1. -->
    <ComponentGroup Id="FfmpegComponents" Directory="BinFolder">
      <Component Id="FfmpegExeComponent" Bitness="always64">
        <File Id="FfmpegExe" Name="ffmpeg.exe" Source="bin\ffmpeg.exe" KeyPath="yes" />
      </Component>
      <Component Id="FfprobeExeComponent" Bitness="always64">
        <File Id="FfprobeExe" Name="ffprobe.exe" Source="bin\ffprobe.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- When XUVA_RUNTIME_HOME is supplied, write it into the service's own
         per-service Environment (REG_MULTI_SZ), which the SCM applies at start.
         The component is only installed when the property is non-empty, so a
         default install leaves the service to pick C:\ProgramData\Xuva itself.
         Written before InstallServices populates the rest of the service key;
         ServiceInstall preserves this separate value. Removed on uninstall. -->
    <Component Id="ServiceEnvironmentComponent" Bitness="always64" Directory="INSTALLFOLDER"
               Condition="XUVA_RUNTIME_HOME">
      <RegistryValue
          Root="HKLM"
          Key="SYSTEM\CurrentControlSet\Services\XuvaMediaServer"
          Name="Environment"
          Type="multiString"
          KeyPath="yes">
        <MultiStringValue Value="XUVA_RUNTIME_HOME=[XUVA_RUNTIME_HOME]" />
      </RegistryValue>
    </Component>

    <!-- The AutoUpdate opt-out flag the service consults. When enabled, the
         LocalSystem service registers the SYSTEM scheduled task at startup via
         schtasks command-line flags (see ensureUpdaterTask) — no task XML is
         shipped, so there's no /create /xml encoding/schema to get wrong. The
         service also self-heals the task and honors a post-install toggle. -->
    <Component Id="UpdaterTaskComponent" Bitness="always64" Directory="INSTALLFOLDER">
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\Xuva"
          Name="AutoUpdate"
          Type="string"
          Value="[XUVA_AUTO_UPDATE]"
          KeyPath="yes" />
    </Component>

    <!-- Start Menu shortcut for the Electron tray app. Installed only when
         TrayFeature is selected (see Feature/ComponentRef above). The Shortcut
         Target uses a [TrayInstallFolder] path rather than a File-Id reference
         because the harvested File Ids in tray.wxs are generated by heat and
         not stable across electron-builder version changes — the install-time
         folder path is stable. The component lives in the Start Menu folder
         (a per-machine path under "All Users") and uses an HKLM RegistryValue
         as its KeyPath so MSI tracks it without a file-in-Start-Menu hack.
         RemoveFolder cleans the empty Xuva\ folder on uninstall. -->
    <Component Id="TrayShortcutComponent" Bitness="always64" Directory="XuvaStartMenuFolder">
      <Shortcut Id="XuvaTrayShortcut"
                Name="Xuva"
                Description="Open the Xuva tray app"
                Target="[TrayInstallFolder]Xuva.exe"
                WorkingDirectory="TrayInstallFolder" />
      <RemoveFolder Id="RemoveXuvaStartMenuFolder" On="uninstall" />
      <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\Xuva"
          Name="TrayShortcutInstalled"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <!-- On a real uninstall (not the transient uninstall half of a major
         upgrade — guarded by NOT UPGRADINGPRODUCTCODE), remove the scheduled
         task the service registered. Deferred + no-impersonate so it runs as
         SYSTEM with rights to delete a SYSTEM task; the command is fully literal
         (no formatted properties) so it needs no CustomActionData or extension.
         Return="ignore": a missing task or schtasks hiccup must not fail
         uninstall — worst case the service would have removed it anyway. -->
    <!-- Working dir is the (already-declared) install folder; schtasks.exe is
         resolved from the system PATH, so the working dir is immaterial. Using
         INSTALLFOLDER avoids declaring an extra StandardDirectory. Two CAs —
         one per task the service registers (the every-6h task and the at-boot
         task). Return="ignore" so a missing task never fails uninstall. -->
    <CustomAction Id="RemoveUpdaterTask"
                  Directory="INSTALLFOLDER"
                  ExeCommand="schtasks.exe /delete /tn &quot;Xuva\XuvaUpdater&quot; /f"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <CustomAction Id="RemoveUpdaterBootTask"
                  Directory="INSTALLFOLDER"
                  ExeCommand="schtasks.exe /delete /tn &quot;Xuva\XuvaUpdater-AtBoot&quot; /f"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RemoveUpdaterTask" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveUpdaterBootTask" After="RemoveUpdaterTask"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
