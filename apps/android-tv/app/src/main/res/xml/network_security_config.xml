<?xml version="1.0" encoding="utf-8"?>
<!-- Xuva is a LAN-first server. Many setups will reach the server over plain
     HTTP on a local address (RFC1918 / link-local). Allowing cleartext for
     local IPs only keeps the public-internet posture strict (HTTPS or refuse)
     while permitting the home-server use case. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.0.0/8</domain>
        <domain includeSubdomains="true">172.16.0.0/12</domain>
        <domain includeSubdomains="true">192.168.0.0/16</domain>
        <domain includeSubdomains="true">169.254.0.0/16</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">.local</domain>
    </domain-config>
</network-security-config>
