<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Allow AVFoundation (and URLSession) to load HTTP media from LAN servers.
		     NSAllowsLocalNetworking covers RFC-1918 addresses (10.x.x.x, 192.168.x.x,
		     172.16-31.x.x) and .local Bonjour hosts — exactly where a self-hosted
		     Xuva server lives.  This is narrower than NSAllowsArbitraryLoads and does
		     not weaken connections to internet addresses. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Without NSLocalNetworkUsageDescription, iOS silently refuses to use
	     any local-network API (including NWBrowser for mDNS) AND never shows
	     the permission prompt — discovery fails completely with no UI signal.
	     Required alongside NSBonjourServices for the Bonjour browser in
	     XuvaDiscovery.swift to function. The string is shown verbatim in the
	     first-launch permission prompt and in Settings → Privacy → Local
	     Network so keep it short and user-readable. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Xuva needs your local network to find and stream from Xuva media servers in your home.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_xuva._tcp</string>
	</array>
</dict>
</plist>
